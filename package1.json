[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[pipenv]
allow_prereleases = false

[dev-packages]
pytest = "==7.2.0"
pytest-cov = "~=2.12.1"
pylint = "~=2.8"
aenum = "~=3.1"
moto = "==4.1.14"
requests-mock = "*"
pre-commit = "*"
black = "24.3.0"

[packages]
alembic = "~=1.6.5"
cryptography = "==46.0.5"
envyaml = ">=1.8.210417"
email-validator = "~=1.1"
fastapi = "==0.115.3"
iso3166 = "~=1.0.1"
iso4217 = "~=1.6"
pycountry = "22.3.5"
mysqlclient  = "==2.2.3"
python-dateutil = "~=2.8"
pymysql = "~=1.1"
python-multipart = "==0.0.22"
python-json-logger = "~=2.0"
requests = "==2.32.4"
sqlalchemy = "~=1.4"
uvicorn = "==0.30.6"
validators = "==0.21.0"
svix = "==0.60.0"
base58 = "2.1.0"
google-auth = "==2.48.0"
python-dotenv = "0.19.0"
sendgrid = "6.8.2"
secure="~=0.3.0"
pyjwt="==2.4.0"
svix-ksuid="~=0.6.0"
language-tags = "*"
setproctitle = "~=1.2.3"
mako = "==1.2.2"
urllib3 = "==2.7.0"
jinja2 = "==3.1.6"
werkzeug = "==3.1.6"
aws-encryption-sdk = "==4.0.0"
pyyaml= "===6.0.1"
zipp = "==3.19.1"
idna = "==3.7"
ddtrace = "==2.20.0"
protobuf = "==5.29.6"
certifi = "==2024.7.4"
setuptools = "==80.10.2"
httpx = "==0.27.0"
coverage = "==7.9.1"
pycurl = "==7.45.4"
celery = "==5.4.0"
boto3 = "==1.38.44"
botocore = "==1.38.45"
pytz = "==2025.2"
kombu = "==5.4.2"
openpyxl = "==3.1.5"
starlette = "==0.40.0"
pydantic = "<2"

[scripts]
db-migration = "alembic upgrade head"
lint = "pylint --rcfile .pylintrc --reports=y app"
start = "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
unittests = "pytest tests --ddtrace --cov=app --cov-report=xml"
format = """
sh -c '
changed_files=$(git diff --name-only origin/master...HEAD; git diff --name-only);
if [ -n "$changed_files" ]; then
  echo "$changed_files" | xargs pre-commit run --files;
else
  echo "No changed files to lint against master.";
fi
'
"""
